# ─── Supabase Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your project values.
# Never commit .env.local to version control.
#
# NOTE: This is a Vite project. Variables must be prefixed with VITE_ to be
# exposed to the browser bundle (Vite convention). The Supabase docs show
# NEXT_PUBLIC_ for Next.js projects — this project uses VITE_ instead.

# ── Supabase Project (Required for Vercel & Local) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# ── Feature Flag ────────────────────────────────────────────────────────────────
# Set to "true" in production (Vercel Project Settings → Environment Variables)
# When "false" (or unset), all services fall back to local mock data.
VITE_USE_SUPABASE=true

# ── Vercel Project Environment Setup ───────────────────────────────────────────
# Configure the following 3 variables in your Vercel Project Settings:
#   1. VITE_SUPABASE_URL     = https://<project-ref>.supabase.co
#   2. VITE_SUPABASE_ANON_KEY = <your-anon-publishable-key>
#   3. VITE_USE_SUPABASE     = true
#
# IMPORTANT SECURITY WARNING:
# NEVER set SUPABASE_SERVICE_ROLE_KEY or VITE_SUPABASE_SERVICE_ROLE_KEY!
# The service-role key gives full bypass access to RLS and must NEVER be exposed.
