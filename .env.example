# ─── Supabase Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your project values.
# Never commit .env.local to version control.
#
# NOTE: This is a Vite project. Variables must be prefixed with VITE_ to be
# exposed to the browser bundle (Vite convention). The Supabase docs show
# NEXT_PUBLIC_ for Next.js projects — this project uses VITE_ instead.

# ── Supabase Project ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Feature Flag ────────────────────────────────────────────────────────────────
# Set to "true" to enable live Supabase queries.
# When "false" (or unset), all services fall back to the local mock data.
VITE_USE_SUPABASE=false

# ── Cross-reference ─────────────────────────────────────────────────────────────
# If you are reading this from a Next.js context, the equivalents are:
#   NEXT_PUBLIC_SUPABASE_URL     → VITE_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY → VITE_SUPABASE_ANON_KEY
